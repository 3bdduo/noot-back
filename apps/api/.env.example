# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public frontend URL (used in emails, SEO canonical URLs, sitemap)
APP_URL=http://localhost:3000
# Comma separated list of allowed browser origins (CORS + cookie CSRF origin check)
CORS_ORIGINS=http://localhost:3000
# TEMPORARY brand placeholders -> replace once the client sends the real values
BRAND_NAME=Notebook Brand
BRAND_DOMAIN=brand-domain.com
ORDER_NUMBER_PREFIX=NB

# ---------------------------------------------------------------------------
# Database: MongoDB Atlas (a replica set is REQUIRED: the code uses transactions; Atlas always is one,
# including the free M0 cluster). Atlas -> Connect -> Drivers -> copy the URI and put the database name
# before the "?" (here: notebook_store). Allow your IP (or 0.0.0.0/0 on Vercel) in Atlas Network Access.
# ---------------------------------------------------------------------------
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/notebook_store?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Cookie settings for the refresh token. Cross-site frontend (different domain) needs SAMESITE=none + SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Google Login: OAuth client id created in Google Cloud Console (leave empty to disable)
GOOGLE_CLIENT_ID=
# Force 2FA for every admin-level account (recommended in production)
ADMIN_REQUIRE_2FA=false

# ---------------------------------------------------------------------------
# Email (Resend). Empty key = emails are only logged to the console.
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=Notebook Brand <no-reply@brand-domain.com>
# Reserved for future SMS / WhatsApp providers
SMS_API_KEY=

# ---------------------------------------------------------------------------
# Storage (Cloudflare R2, S3 compatible)
# ---------------------------------------------------------------------------
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Public base URL for public assets (R2 public bucket / custom domain), no trailing slash
STORAGE_PUBLIC_URL=
# Optional: override endpoint (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=

# ---------------------------------------------------------------------------
# Payments (providers are NOT implemented yet).
# none = online payment disabled (COD only) | mock = local test provider (never in production)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=none
PAYMENT_MOCK_SECRET=dev-mock-webhook-secret

# ---------------------------------------------------------------------------
# Cron / jobs. Vercel Cron (or any external pinger) calls GET /api/v1/internal/cron/tick
# with header: Authorization: Bearer <CRON_SECRET>
# ---------------------------------------------------------------------------
CRON_SECRET=change-me-cron-secret

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
ENABLE_SWAGGER=true
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed (npm run db:seed) - first Super Admin
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@brand-domain.com
SEED_ADMIN_PASSWORD=ChangeMe!12345

# Demo catalogue + ACTIVE shipping zones on seed (true/false)
SEED_DEMO=false
