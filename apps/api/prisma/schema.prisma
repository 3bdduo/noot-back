// ============================================================================
// Premium Custom Notebook & Stationery — database schema (MongoDB Atlas + Prisma)
// Money is stored as INTEGER piasters (1 EGP = 100). JSON is used only for
// snapshots / provider logs / config blobs, never for core business data.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Locale {
  ar
  en
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CustomizationGroupType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TEXT
  DATE
  FILE
}

enum TextCharset {
  ARABIC
  LATIN
  DIGITS
  SYMBOLS
  SPACE
}

enum ArtworkStatus {
  PENDING_UPLOAD
  READY
  REJECTED
  DELETED
}

enum UploadPurpose {
  ARTWORK
  PRODUCT_MEDIA
  OPTION_MEDIA
  REVIEW_IMAGE
  CONTENT
}

enum CustomizationReviewStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_CHANGES
  REJECTED
  SENT_TO_PRODUCTION
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING_PAYMENT
  COD_PENDING
  PAYMENT_CONFIRMED
  CUSTOMIZATION_REVIEW
  CUSTOMIZATION_APPROVED
  IN_PRODUCTION
  QUALITY_CHECK
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COD_PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  WALLET
  COD
}

enum PaymentTransactionType {
  CREATE
  AUTHORIZE
  CAPTURE
  VERIFY
  REFUND
  WEBHOOK
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
  PROVIDER
}

enum ReservationStatus {
  ACTIVE
  FINALIZED
  RELEASED
  EXPIRED
}

enum InventoryMovementType {
  IN
  OUT
  RESERVE
  RELEASE
  ADJUSTMENT
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum HomepageSectionType {
  HERO
  FEATURED_PRODUCTS
  COLLECTIONS
  BRAND_STATEMENT
  BUILD_YOUR_NOTEBOOK
  PERSONALIZATION
  PAPER_QUALITY
  PACKAGING
  GIFTS
  TESTIMONIALS
  INSTAGRAM
  NEWSLETTER
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

// ----------------------------------------------------------------------------
// Identity & access
// ----------------------------------------------------------------------------

model User {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  email            String     @unique
  emailVerifiedAt  DateTime?
  passwordHash     String?
  googleId         String?    @unique
  firstName        String
  lastName         String
  phone            String?
  locale           Locale     @default(ar)
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  marketingOptIn   Boolean    @default(false)
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roles         UserRole[]
  addresses     Address[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  savedDesigns  SavedDesign[]
  artworkFiles  ArtworkFile[]
  couponUsages  CouponUsage[]
  auditLogs     AuditLog[]

  @@index([phone])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  key         String           @unique
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  roleId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String @db.ObjectId
  permissionId String @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Address {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  label      String?
  firstName  String
  lastName   String
  phone      String
  governorate String
  city       String
  street     String
  building   String?
  apartment  String?
  postalCode String?
  notes      String?
  isDefault  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model EmailToken {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// COD abuse protection: phones that may never place cash-on-delivery orders.
model BlockedPhone {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Product {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  slug           String        @unique
  sku            String?       @unique
  status         ProductStatus @default(DRAFT)
  basePrice      Int
  compareAtPrice Int?
  isCustomizable Boolean       @default(false)
  isGift         Boolean       @default(false)
  featured       Boolean       @default(false)
  leadTimeDays   Int           @default(0)
  material       String?
  sortOrder      Int           @default(0)
  avgRating      Float         @default(0)
  reviewCount    Int           @default(0)
  salesCount     Int           @default(0)
  /// Normalised (Arabic-folded, lower-cased) text used by shop search.
  searchText     String        @default("")
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  translations   ProductTranslation[]
  variants       ProductVariant[]
  media          ProductMedia[]
  categories     ProductCategory[]
  collections    ProductCollection[]
  customizations ProductCustomization[]
  reviews        Review[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  cartItems      CartItem[]
  savedDesigns   SavedDesign[]
  couponProducts CouponProduct[]
  homepageItems  HomepageSectionProduct[]
  stockAlerts    BackInStockSubscription[]

  @@index([status, deletedAt])
  @@index([featured])
  @@index([createdAt])
}

model ProductTranslation {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  productId       String @db.ObjectId
  locale          Locale
  name            String
  shortDescription String?
  description     String?
  seoTitle        String?
  seoDescription  String?
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductVariant {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  sku        String    @unique
  color      String?
  material   String?
  size       String?
  paper      String?
  priceDelta Int       @default(0)
  isDefault  Boolean   @default(false)
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductVariantTranslation[]
  inventory    InventoryItem?
  media        ProductMedia[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId, isActive])
}

model ProductVariantTranslation {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  variantId String @db.ObjectId
  locale    Locale
  name      String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locale])
}

model ProductMedia {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId
  variantId String? @db.ObjectId
  type      MediaType       @default(IMAGE)
  url       String
  storageKey String?
  alt       String?
  sortOrder Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  slug      String    @unique
  parentId  String?   @db.ObjectId
  imageUrl  String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]
}

model CategoryTranslation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String @db.ObjectId
  locale      Locale
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Collection {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  slug      String    @unique
  imageUrl  String?
  featured  Boolean   @default(false)
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  translations   CollectionTranslation[]
  products       ProductCollection[]
  couponCollections CouponCollection[]
  homepageItems  HomepageSectionCollection[]
}

model CollectionTranslation {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  collectionId String @db.ObjectId
  locale       Locale
  name         String
  description  String?
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
}

model ProductCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  categoryId String @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  productId    String @db.ObjectId
  collectionId String @db.ObjectId
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@unique([productId, collectionId])
  @@index([collectionId])
}

// ----------------------------------------------------------------------------
// Customization engine (reusable: Groups + Options + product links)
// ----------------------------------------------------------------------------

model CustomizationGroup {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  code                String                 @unique
  /// Wizard step this group belongs to (purpose, size, cover, paper, personalization, accessories, packaging...)
  stepKey             String
  type                CustomizationGroupType
  required            Boolean                @default(false)
  /// When true only ONE group of the same step may be filled (e.g. name OR initials OR upload).
  exclusiveWithinStep Boolean                @default(false)
  minSelect           Int                    @default(0)
  maxSelect           Int?
  // TEXT rules
  minLength           Int?
  maxLength           Int?
  allowedCharsets     TextCharset[]
  pattern             String?
  // DATE rules: none besides format
  // FILE rules
  allowedMimeTypes    String[]
  maxFileSizeBytes    Int?
  minWidthPx          Int?
  minHeightPx         Int?
  maxWidthPx          Int?
  maxHeightPx         Int?
  /// Flat fee when a TEXT / DATE / FILE group is filled.
  priceDelta          Int                    @default(0)
  sortOrder           Int                    @default(0)
  active              Boolean                @default(true)
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  translations CustomizationGroupTranslation[]
  options      CustomizationOption[]
  products     ProductCustomization[]
  artworkFiles ArtworkFile[]

  @@index([stepKey, sortOrder])
}

model CustomizationGroupTranslation {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId     String @db.ObjectId
  locale      Locale
  name        String
  description String?
  placeholder String?
  helpText    String?
  group       CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, locale])
}

model CustomizationOption {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId          String @db.ObjectId
  code             String
  imageUrl         String?
  /// Transparent layer used by the live 2D preview.
  previewLayerUrl  String?
  colorHex         String?
  priceDelta       Int                @default(0)
  sku              String?            @unique
  isDefault        Boolean            @default(false)
  sortOrder        Int                @default(0)
  active           Boolean            @default(true)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  group            CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  translations CustomizationOptionTranslation[]
  inventory    InventoryItem?

  @@unique([groupId, code])
}

model CustomizationOptionTranslation {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  optionId    String @db.ObjectId
  locale      Locale
  name        String
  description String?
  option      CustomizationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

model ProductCustomization {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId
  groupId   String @db.ObjectId
  sortOrder Int                @default(0)
  /// Overrides the group's `required` flag for this product when not null.
  required  Boolean?
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([productId, groupId])
  @@index([groupId])
}

/// Server-priced configuration saved by a signed-in customer (P2).
model SavedDesign {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  productId  String @db.ObjectId
  variantId  String?
  name       String
  /// Selection input exactly as the customizer sent it.
  selections Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ArtworkFile {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String? @db.ObjectId
  guestToken    String?
  groupId       String? @db.ObjectId
  purpose       UploadPurpose @default(ARTWORK)
  storageKey    String        @unique
  thumbnailKey  String?
  originalName  String
  mimeType      String
  sizeBytes     Int
  widthPx       Int?
  heightPx      Int?
  status        ArtworkStatus @default(PENDING_UPLOAD)
  retentionUntil DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  group      CustomizationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  selections CustomizationSelection[]

  @@index([userId])
  @@index([guestToken])
  @@index([status, createdAt])
}

// ----------------------------------------------------------------------------
// Commerce: cart, wishlist, coupons, gifts
// ----------------------------------------------------------------------------

model Cart {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String?   @unique @db.ObjectId
  guestToken           String?   @unique
  couponCode           String?
  abandonedEmailSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   CartItem[]
  gift    GiftMessage?

  @@index([updatedAt])
}

model CartItem {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  cartId         String @db.ObjectId
  productId      String @db.ObjectId
  variantId      String @db.ObjectId
  quantity       Int
  /// Stable fingerprint of the customization input, so identical configs merge and different ones stay separate.
  configHash     String
  /// The shopper's selections (input only; prices are always recomputed server-side).
  customization  Json?
  savedForLater  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, configHash, savedForLater])
  @@index([cartId])
}

model Wishlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String         @unique @db.ObjectId
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  wishlistId String @db.ObjectId
  productId  String @db.ObjectId
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([wishlistId, productId])
}

model Coupon {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  code         String       @unique
  type         DiscountType
  /// PERCENTAGE: basis points (1000 = 10%). FIXED: piasters.
  value        Int
  minSubtotal  Int?
  maxDiscount  Int?
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  perUserLimit Int?
  usedCount    Int          @default(0)
  active       Boolean      @default(true)
  appliesToAll Boolean      @default(true)
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  products    CouponProduct[]
  collections CouponCollection[]
  usages      CouponUsage[]
  orders      Order[]
}

model CouponProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  couponId  String @db.ObjectId
  productId String @db.ObjectId
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([couponId, productId])
}

model CouponCollection {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  couponId     String @db.ObjectId
  collectionId String @db.ObjectId
  coupon       Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@unique([couponId, collectionId])
}

model CouponUsage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId   String @db.ObjectId
  userId     String? @db.ObjectId
  guestEmail String?
  orderId    String   @unique @db.ObjectId
  discount   Int
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model GiftMessage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId        String?  @unique @db.ObjectId
  orderId       String?  @unique @db.ObjectId
  recipientName String?
  senderName    String?
  message       String
  hidePrices    Boolean  @default(false)
  createdAt     DateTime @default(now())
  cart          Cart?    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber         String        @unique
  userId              String? @db.ObjectId
  guestEmail          String?
  guestPhone          String?
  contactEmail        String
  contactPhone        String
  status              OrderStatus
  paymentStatus       PaymentStatus
  paymentMethod       PaymentMethod
  subtotal            Int
  discount            Int           @default(0)
  shippingFee         Int           @default(0)
  codFee              Int           @default(0)
  tax                 Int           @default(0)
  total               Int
  currency            String        @default("EGP")
  couponId            String? @db.ObjectId
  couponCode          String?
  governorate         String
  shippingAddress     Json
  billingAddress      Json?
  customerNote        String?
  locale              Locale        @default(ar)
  idempotencyKey      String?       @unique
  hasCustomization    Boolean       @default(false)
  estimatedDeliveryAt DateTime?
  /// Inventory reservation deadline (online payment window / COD confirmation window).
  reservationExpiresAt DateTime?
  paidAt              DateTime?
  confirmedAt         DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  placedAt            DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon       Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  history      OrderStatusHistory[]
  notes        OrderNote[]
  payments     Payment[]
  refunds      Refund[]
  reservations InventoryReservation[]
  shipments    Shipment[]
  couponUsage  CouponUsage?
  gift         GiftMessage?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([contactEmail])
  @@index([contactPhone])
  @@index([governorate])
}

model OrderItem {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  orderId                  String @db.ObjectId
  productId                String @db.ObjectId
  variantId                String @db.ObjectId
  quantity                 Int
  unitPrice                Int
  totalPrice               Int
  productSnapshot          Json
  variantSnapshot          Json
  customizationSnapshot    Json?
  leadTimeDays             Int                        @default(0)
  customizationReviewStatus CustomizationReviewStatus?
  customizationReviewNote  String?
  reviewedById             String?
  reviewedAt               DateTime?
  refundedAmount           Int                        @default(0)
  createdAt                DateTime                   @default(now())

  order      Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  selections CustomizationSelection[]
  revisions  OrderItemRevision[]
  shipmentItems ShipmentItem[]
  reviews    Review[]

  @@index([orderId])
  @@index([productId])
  @@index([customizationReviewStatus])
}

/// One row per customization choice made on an order item (analytics + production sheet).
model CustomizationSelection {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  orderItemId   String @db.ObjectId
  stepKey       String
  groupCode     String
  groupType     CustomizationGroupType
  optionCode    String?
  textValue     String?
  dateValue     DateTime?
  artworkFileId String? @db.ObjectId
  priceDelta    Int          @default(0)
  nameSnapshot  String?
  createdAt     DateTime     @default(now())
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  artworkFile   ArtworkFile? @relation(fields: [artworkFileId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([groupCode, optionCode])
}

/// Previous customization snapshots kept when a shopper edits personalization before production.
model OrderItemRevision {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  orderItemId String @db.ObjectId
  snapshot    Json
  changedById String?
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderStatusHistory {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String @db.ObjectId
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actorType  ActorType    @default(SYSTEM)
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String @db.ObjectId
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// Payments (provider integrations are intentionally NOT implemented yet)
// ----------------------------------------------------------------------------

model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String @db.ObjectId
  method      PaymentMethod
  provider    String?
  status      PaymentStatus @default(PENDING)
  amount      Int
  currency    String        @default("EGP")
  providerRef String?
  failureReason String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([provider, providerRef])
  @@index([status])
}

model PaymentTransaction {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  paymentId             String @db.ObjectId
  type                  PaymentTransactionType
  status                String
  amount                Int                    @default(0)
  providerTransactionId String?
  /// Sanitised provider response for debugging. Never contains card data.
  rawResponse           Json?
  createdAt             DateTime               @default(now())
  payment               Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PaymentWebhookEvent {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  provider       String
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean       @default(false)
  status         WebhookStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?

  @@unique([provider, eventId])
}

model Refund {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  paymentId        String @db.ObjectId
  orderId          String @db.ObjectId
  orderItemId      String?
  amount           Int
  reason           String?
  status           RefundStatus @default(PENDING)
  requestedById    String?
  providerRefundId String?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
}

// ----------------------------------------------------------------------------
// Inventory (variants AND customization components share one model)
// ----------------------------------------------------------------------------

model InventoryItem {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  variantId         String?  @unique @db.ObjectId
  optionId          String?  @unique @db.ObjectId
  sku               String?
  quantity          Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  trackInventory    Boolean  @default(true)
  allowBackorder    Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  variant      ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option       CustomizationOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  @@index([quantity])
}

model InventoryReservation {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String @db.ObjectId
  inventoryItemId String @db.ObjectId
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  finalizedAt     DateTime?
  releasedAt      DateTime?
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([status, expiresAt])
}

model InventoryMovement {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  inventoryItemId String @db.ObjectId
  type            InventoryMovementType
  quantity        Int
  quantityAfter   Int
  reservedAfter   Int
  orderId         String?
  reason          String?
  actorId         String?
  createdAt       DateTime              @default(now())
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
  @@index([orderId])
}

model BackInStockSubscription {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  email      String
  locale     Locale    @default(ar)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
}

// ----------------------------------------------------------------------------
// Shipping
// ----------------------------------------------------------------------------

model ShippingZone {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  nameAr           String
  nameEn           String
  estimatedDaysMin Int      @default(2)
  estimatedDaysMax Int      @default(4)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  governorates ShippingZoneGovernorate[]
  rates        ShippingRate[]
}

model ShippingZoneGovernorate {
  governorate String       @id @map("_id")
  zoneId      String @db.ObjectId
  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

model ShippingRate {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  zoneId             String @db.ObjectId
  name               String
  baseFee            Int
  freeOverSubtotal   Int?
  codAvailable       Boolean      @default(true)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  zone               ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, active])
}

model Shipment {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId             String @db.ObjectId
  carrier             String         @default("manual")
  trackingNumber      String?
  trackingUrl         String?
  status              ShipmentStatus @default(PENDING)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  ShipmentItem[]
  events ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId  String @db.ObjectId
  orderItemId String @db.ObjectId
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  @@unique([shipmentId, orderItemId])
}

model ShipmentEvent {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  shipmentId  String @db.ObjectId
  status      ShipmentStatus
  description String?
  location    String?
  source      String         @default("admin")
  occurredAt  DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model TaxRate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  /// Basis points (1400 = 14%).
  rateBps   Int
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Reviews
// ----------------------------------------------------------------------------

model Review {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  productId        String @db.ObjectId
  userId           String @db.ObjectId
  orderItemId      String? @db.ObjectId
  rating           Int
  title            String?
  body             String?
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(true)
  adminResponse    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images    ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status])
}

model ReviewImage {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  reviewId   String @db.ObjectId
  url        String
  storageKey String?
  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Content
// ----------------------------------------------------------------------------

model JournalPost {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  slug        String        @unique
  coverUrl    String?
  authorId    String?
  authorName  String?
  category    String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations JournalPostTranslation[]

  @@index([status, publishedAt])
}

model JournalPostTranslation {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  postId         String @db.ObjectId
  locale         Locale
  title          String
  excerpt        String?
  content        String
  seoTitle       String?
  seoDescription String?
  post           JournalPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}

model Banner {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  placement    String
  imageUrl     String
  mobileImageUrl String?
  linkUrl      String?
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  translations BannerTranslation[]

  @@index([placement, active])
}

model BannerTranslation {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  bannerId String @db.ObjectId
  locale   Locale
  title    String?
  subtitle String?
  ctaLabel String?
  banner   Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
}

model HomepageSection {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  type      HomepageSectionType
  sortOrder Int                 @default(0)
  active    Boolean             @default(true)
  imageUrl  String?
  linkUrl   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  translations HomepageSectionTranslation[]
  products     HomepageSectionProduct[]
  collections  HomepageSectionCollection[]
}

model HomepageSectionTranslation {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  sectionId String @db.ObjectId
  locale    Locale
  title     String?
  subtitle  String?
  body      String?
  ctaLabel  String?
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
}

model HomepageSectionProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  sectionId String @db.ObjectId
  productId String @db.ObjectId
  sortOrder Int             @default(0)
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([sectionId, productId])
}

model HomepageSectionCollection {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  sectionId    String @db.ObjectId
  collectionId String @db.ObjectId
  sortOrder    Int             @default(0)
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  collection   Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@unique([sectionId, collectionId])
}

model Testimonial {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  authorName String
  avatarUrl  String?
  rating     Int?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  translations TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  testimonialId String @db.ObjectId
  locale        Locale
  quote         String
  authorTitle   String?
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, locale])
}

model InstagramPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String
  linkUrl   String
  caption   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  translations FaqItemTranslation[]
}

model FaqItemTranslation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  faqId    String @db.ObjectId
  locale   Locale
  question String
  answer   String
  faq      FaqItem @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
}

/// Static pages: about, terms, privacy, shipping-policy, refund-policy...
model Page {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  translations PageTranslation[]
}

model PageTranslation {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  pageId         String @db.ObjectId
  locale         Locale
  title          String
  content        String
  seoTitle       String?
  seoDescription String?
  page           Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

model NewsletterSubscriber {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  locale         Locale    @default(ar)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model ContactMessage {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ----------------------------------------------------------------------------
// Operations
// ----------------------------------------------------------------------------

model Setting {
  key       String   @id @map("_id")
  value     Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String? @db.ObjectId
  channel   NotificationChannel
  event     String
  title     String
  body      String
  toAddress String?
  locale    Locale              @default(ar)
  data      Json?
  status    NotificationStatus  @default(PENDING)
  attempts  Int                 @default(0)
  error     String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, channel])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String? @db.ObjectId
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// DB-backed job queue (serverless friendly). Drained by the cron endpoint.
model Job {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
  @@index([type])
}
